# ─────────────────────────────────────────────────────────────────────────────
# RG Production Dashboard — Variables de entorno requeridas
# Copia este archivo como .env para desarrollo local.
# En producción (Railway) estas variables van en el panel de Railway.
# NUNCA commitear .env — está en .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (OBLIGATORIO) ───────────────────────────────────────────────────
# URL de tu proyecto Supabase (sin slash al final)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Clave anónima — inyectada en el HTML del cliente (safe para frontend)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Clave de servicio — usada server-side para bypasear RLS (NUNCA expongas en cliente)
SUPABASE_SECRET_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Aliases aceptados por el código (Railway puede usar cualquier combinación):
# SUPABASE_PROJECT_URL      = mismo valor que SUPABASE_URL
# NEXT_PUBLIC_SUPABASE_URL  = mismo valor que SUPABASE_URL
# SUPABASE_SERVICE_ROLE_KEY = mismo valor que SUPABASE_SECRET_KEY
# SUPABASE_SERVICE_KEY      = mismo valor que SUPABASE_SECRET_KEY

# ── Anthropic / Claude API (OBLIGATORIO) ─────────────────────────────────────
# Usada para: /api/stream/organizador, /api/generar-bot, /api/document*
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── Facebook / Instagram OAuth ───────────────────────────────────────────────
# App ID de tu app en developers.facebook.com (visible en frontend — no es secreto)
FB_APP_ID=1981039516112644

# App Secret — solo server-side, NUNCA expongas en cliente
FB_APP_SECRET=tu_app_secret_aqui

# Token de usuario de larga duración para publicar como página (si no usas OAuth por cliente)
FB_USER_TOKEN=

# ── URL pública del sitio ────────────────────────────────────────────────────
# En Railway se asigna automáticamente. En local: http://localhost:3000
SITE_URL=https://web-production-3d2c.up.railway.app

# ── Publicación en redes sociales (Blotato) ──────────────────────────────────
# Requerida para /api/content/approve y herramienta generar_y_publicar
BLOTATO_API_KEY=bl_...

# ID de cuenta Blotato para Arranca Financial (hardcoded default: 32320)
# Sobreescribir aquí si se cambia de cuenta
BLOTATO_ACCOUNT_ID=32320

# ── Generación de imágenes (Higgsfield) ──────────────────────────────────────
# Requerida para el flujo generar_y_publicar vía MCP de Higgsfield
HIGGSFIELD_API_KEY=hf_...

# ── Generación de video (kie.ai / Seedance) ──────────────────────────────────
# Modelos: bytedance/seedance-2-fast (video UGC), nano-banana-2 (imagen fallback)
KIE_API_KEY=kie_...

# ── HeyGen — Avatares de video ───────────────────────────────────────────────
# Requerida para /api/heygen/avatares, /api/heygen/voces, /api/portal/create-avatar
HEYGEN_API_KEY=

# ── Google Drive — Biblioteca de media ──────────────────────────────────────
# Requeridas para /gdrive/listar y /gdrive/referencias
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ID de carpeta raíz de Google Drive (default: 'root')
GDRIVE_ROOT_FOLDER=root

# ID de carpeta de referencias (default: GDRIVE_ROOT_FOLDER)
GDRIVE_REF_FOLDER=

# ── Twilio — Click-to-call ───────────────────────────────────────────────────
# Requerido para POST /api/call/iniciar
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=tu_auth_token_aqui
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# ── Resend — Emails transaccionales ─────────────────────────────────────────
# Requerido para reset de contraseña del portal cliente
# Si no está configurado, el link de reset se imprime en los logs del servidor
RESEND_API_KEY=re_...

# ── Telegram — Notificaciones de nuevo cliente ───────────────────────────────
# Requerido para alertas en POST /api/onboard-cliente
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=123456789

# ── Scheduler — Secret interno ───────────────────────────────────────────────
# Auth entre dashboard y el bot scheduler de Railway
# CAMBIAR en producción — default inseguro: 'agencia-scheduler-2025'
SCHEDULER_SECRET=cambia_esto_en_produccion

# ── Dev Agent — proxy interno ────────────────────────────────────────────────
# URL del servicio devagent en Railway (si está desplegado)
DEVAGENT_URL=
# Secret para autenticar requests al devagent
DEVAGENT_SECRET=agencia-dev-2025

# ── Seguridad — Hash de contraseñas del portal ───────────────────────────────
# Salt usado para HMAC-SHA256 de contraseñas de clientes del portal
# CAMBIAR en producción — default inseguro: 'rg_production_2026'
PW_SALT=cambia_esto_en_produccion

# ── Seguridad — Protección de /api/env-check ─────────────────────────────────
# Si está seteado, /api/env-check requiere header: X-Admin-Secret: <valor>
# Dejar vacío solo en desarrollo local. En producción SIEMPRE setear esto.
ADMIN_SECRET=

# ── Seguridad — Protección del MCP server ────────────────────────────────────
# Si está seteado, POST /mcp requiere header: X-MCP-Secret: <valor>
# Configurar en Railway con: openssl rand -hex 16
# En Claude Code settings: mcpServers.agencia-dashboard.headers.X-MCP-Secret = <valor>
MCP_SECRET=

# ── Puerto (opcional) ────────────────────────────────────────────────────────
# Railway asigna PORT automáticamente. En local default: 3000
PORT=3000
